# DevOmni Environment Configuration Example
# Copy this file to .env and fill in your actual values

# PostgreSQL Database Connection
PG_CONNECTION_STRING=postgresql://username:password@host:port/database

# MySQL Database Configuration
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-username
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database

# MySQL Alternative Connection Strings (optional)
MYSQL_PUBLIC_URL=mysql://username:password@host:port/database
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_URL=mysql://username:password@host:port/database

# MongoDB Configuration
MONGODB_URI=mongodb://username:password@host:port/database
# or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_DATABASE=your-database-name

# DevOmni Configuration
PORT=3000
PROJECT_ROOT=C:\path\to\your\devomni\project